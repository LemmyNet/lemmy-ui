    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-inferno": "^7.42.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
