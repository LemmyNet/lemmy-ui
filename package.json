    "webpack-dev-server": "5.2.5"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=8.9.0"
  },
  "engineStrict": true,
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  }
}
