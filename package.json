{
  "name": "lemmy-ui",
  "version": "1.0.0-beta.3",
  "description": "An isomorphic UI for lemmy",
  "repository": "https://github.com/LemmyNet/lemmy-ui",
  "license": "AGPL-3.0",
  "author": "Dessalines <tyhou13@gmx.com>",
  "scripts": {
    "analyze": "webpack --mode=none",
    "prebuild:dev": "pnpm clean && node generate_translations.js",
    "build:dev": "webpack --env COMMIT_HASH=$(git rev-parse --short HEAD) --mode=development",
    "prebuild:prod": "pnpm clean && node generate_translations.js",
    "build:prod": "webpack --env COMMIT_HASH=$(git rev-parse --short HEAD) --mode=production",
    "clean": "pnpm rimraf dist",
    "dev": "node generate_translations.js && NODE_OPTIONS='--enable-source-maps' pnpm build:dev --watch",
    "lint": "pnpm translations:generate && tsc --noEmit && pnpm eslint --report-unused-disable-directives && pnpm prettier:check",
    "prepare": "husky",
    "prettier:check": "pnpm prettier --check \"src/**/*.{ts,tsx,js,mjs,css,scss}\" README.md package.json webpack.config.js tsconfig.json eslint.config.mjs generate_translations.js .prettierrc.json",
    "prettier:write": "pnpm prettier --write \"src/**/*.{ts,tsx,js,mjs,css,scss}\" README.md package.json webpack.config.js tsconfig.json eslint.config.mjs generate_translations.js .prettierrc.json",
    "run:prod": "node generate_translations.js && pnpm build:prod && node --enable-source-maps dist/js/server.js",
    "themes:build": "sass src/assets/css/themes/:src/assets/css/themes --embed-sources",
    "themes:watch": "sass --watch src/assets/css/themes/:src/assets/css/themes --embed-sources",
    "translations:generate": "node generate_translations.js",
    "translations:init": "git submodule init && pnpm translations:update",
    "translations:update": "git submodule update --remote --recursive"
  },
  "lint-staged": {
    "*.{css, scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write"
    ]
  },
  "browserslist": "fully supports es6 and supports async-functions",
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
