    "classnames": "^2.5.1",
    "clean-webpack-plugin": "^4.0.0",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "copy-webpack-plugin": "^14.0.0",
